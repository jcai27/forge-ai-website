# Optional. A form endpoint that accepts JSON POSTs (e.g. Formspree, Basin, or your own API).
# If unset, the contact form falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=

# Optional. A scheduling link (e.g. Calendly, Cal.com). If unset, "Book a Discovery Call"
# routes to the contact page with the discovery-call intent preselected.
VITE_BOOKING_URL=
